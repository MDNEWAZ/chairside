<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" Version="7.2.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the original resource names: DbUp's journal records scripts by name, so renaming would re-run them. -->
    <EmbeddedResource Include="Scripts\*.sql" LogicalName="DentalStaff.DbMigrator.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
